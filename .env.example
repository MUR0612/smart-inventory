# Template only - every value here is a placeholder and is rejected at startup.
# Create a real .env with random values:   python scripts/init_env.py
# .env is git-ignored; never commit it or put it in a ZIP.

DB_NAME=smart_inventory
# Least-privilege application account (DML only), created by the migration job.
DB_USER=inventory_app
DB_PASSWORD=CHANGE_ME
# Used only by the MySQL container and the migration job.
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Signs login tokens (>= 32 chars) / authenticates order-service -> inventory-service (>= 24 chars).
AUTH_SECRET=CHANGE_ME
SERVICE_TOKEN=CHANGE_ME

# username:role:pbkdf2-hash, comma separated. Roles: staff (read/write), viewer (read only).
# Hash a password with: python scripts/hash_password.py
AUTH_USERS=CHANGE_ME

# Gateway port on the host. Set GATEWAY_BIND=127.0.0.1 to keep it on this machine only.
GATEWAY_PORT=8080
GATEWAY_BIND=0.0.0.0
SEED_DEMO_DATA=true
